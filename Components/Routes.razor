<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <div class="wrap section">
                    <h1>Sign in required</h1>
                    <p>You need an account with the right access to view this page.</p>
                    <a class="btn btn-gold" href="/login">Member Login</a>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="wrap section"><h1>Page not found</h1><a href="/">Back to home</a></div>
        </LayoutView>
    </NotFound>
</Router>
