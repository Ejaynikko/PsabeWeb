@page "/reset-password"
@inject SupabaseApi Api
@inject IJSRuntime JS

<PageTitle>Reset Password - PSABE</PageTitle>

<section class="auth-card">
    <h1>Choose a new password</h1>
    @if (done)
    {
        <div class="alert alert-ok">Your password was updated.</div>
        <a class="btn btn-gold" href="/login?reset=true" data-enhance-nav="false">Log in</a>
    }
    else if (!checkedLink)
    {
        <p class="muted">Checking your reset link...</p>
    }
    else if (token is null)
    {
        <div class="alert alert-error">@(error ?? "This reset link is invalid or has expired.")</div>
        <a href="/forgot-password">Request a new link</a>
    }
    else
    {
        @if (error != null) { <div class="alert alert-error">@error</div> }
        <EditForm Model="Input" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <label class="field">New password (at least 8 characters)
                <InputText type="password" @bind-Value="Input.Password" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Password" />
            </label>
            <label class="field">Confirm new password
                <InputText type="password" @bind-Value="Input.Confirm" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Confirm" />
            </label>
            <button class="btn btn-gold" type="submit">Update password</button>
        </EditForm>
    }
</section>

@code {
    PasswordModel Input = new();
    string? token, error;
    bool checkedLink, done;

    // Supabase puts the recovery token in the URL fragment (#access_token=...), which only the browser can read.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var hash = await JS.InvokeAsync<string>("psabeTakeHash"); // also wipes the token from the address bar
        var q = System.Web.HttpUtility.ParseQueryString(hash.TrimStart('#'));
        if (q["type"] == "recovery" && !string.IsNullOrEmpty(q["access_token"])) token = q["access_token"];
        else error = q["error_description"]?.Replace('+', ' ');
        checkedLink = true;
        StateHasChanged();
    }

    async Task Save()
    {
        error = null;
        try
        {
            await Api.UpdatePassword(token!, Input.Password);
            done = true;
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    public class PasswordModel
    {
        [Required, MinLength(8)] public string Password { get; set; } = "";
        [Required, Compare(nameof(Password), ErrorMessage = "Passwords do not match.")] public string Confirm { get; set; } = "";
    }
}
