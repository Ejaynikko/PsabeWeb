@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@inject SupabaseApi Api
@inject NavigationManager Nav

<PageTitle>Forgot Password - PSABE</PageTitle>

<section class="auth-card">
    <h1>Forgot password</h1>
    @if (sent)
    {
        <div class="alert alert-ok">If an account exists for that email, a reset link is on its way. Check your inbox and spam folder.</div>
    }
    else
    {
        <p class="muted">Enter your account email and we'll send you a link to choose a new password.</p>
        @if (error != null) { <div class="alert alert-error">@error</div> }
        <EditForm Model="Input" FormName="forgot" OnValidSubmit="Send">
            <DataAnnotationsValidator />
            <label class="field">Email
                <InputText type="email" @bind-Value="Input.Email" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" />
            </label>
            <Captcha />
            <button class="btn btn-gold" type="submit">Send reset link</button>
        </EditForm>
    }
    <p class="muted"><a href="/login" data-enhance-nav="false">Back to login</a></p>
</section>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] ForgotModel Input { get; set; } = new();
    bool sent;
    string? error;

    async Task Send()
    {
        var captcha = HttpContext.Request.Form["h-captcha-response"].ToString();
        if (string.IsNullOrEmpty(captcha)) { error = "Please complete the captcha."; return; }
        try
        {
            await Api.Recover(Input.Email, Nav.BaseUri + "reset-password", captcha);
            sent = true; // same message whether or not the email exists, so this can't be used to probe for accounts
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    public class ForgotModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
    }
}
