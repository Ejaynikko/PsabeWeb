@inject NavigationManager Nav

<div class="admin-tabs">
    @foreach (var (href, label) in Tabs)
    {
        <a href="@href" class="@(Nav.Uri.Contains(href, StringComparison.OrdinalIgnoreCase) ? "active" : "")">@label</a>
    }
</div>

@code {
    static readonly (string, string)[] Tabs =
        [("/admin/members", "Members"), ("/admin/events", "Events"), ("/admin/registrations", "Registrations"), ("/admin/news", "News"), ("/admin/officers", "Officers"),
         ("/admin/gallery", "Gallery"), ("/admin/resources", "Resources"), ("/admin/announcements", "Announcements")];
}
