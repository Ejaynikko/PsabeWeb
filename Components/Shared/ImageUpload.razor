@inject SupabaseApi Api

@* Drag-and-drop or click-to-choose image upload; the URL box stays as a fallback. Bind with @bind-Value. *@
<div class="upload">
    <label class="dropzone @(busy ? "busy" : "")" style="position:relative">
        @if (!string.IsNullOrWhiteSpace(Value)) { <img src="@Urls.Safe(Value)" alt="" /> }
        <span class="dz-text"><i class="bi bi-cloud-arrow-up"></i> @(busy ? "Uploading..." : "Drag a photo here or click to choose")</span>
        <InputFile OnChange="Picked" accept="image/png,image/jpeg,image/webp" style="position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer" />
    </label>
    <input type="text" class="upload-url" placeholder="...or paste an image URL" value="@Value" @onchange="UrlChanged" />
    @if (error != null) { <div class="alert alert-error">@error</div> }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Storage folder, e.g. "site/gallery" (admins) or "avatars/{userId}" (members).</summary>
    [Parameter, EditorRequired] public string Folder { get; set; } = "";

    const long MaxBytes = 5 * 1024 * 1024;
    static readonly Dictionary<string, string> Ext = new() { ["image/jpeg"] = "jpg", ["image/png"] = "png", ["image/webp"] = "webp" };

    bool busy;
    string? error;

    Task UrlChanged(ChangeEventArgs a) => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(a.Value?.ToString()) ? null : a.Value!.ToString());

    async Task Picked(InputFileChangeEventArgs e)
    {
        error = null;
        var f = e.File;
        if (!Ext.TryGetValue(f.ContentType, out var ext)) { error = "Only JPG, PNG or WebP images are allowed."; return; }
        if (f.Size > MaxBytes) { error = "The image must be 5 MB or smaller."; return; }

        busy = true;
        try
        {
            await using var stream = f.OpenReadStream(MaxBytes);
            using var ms = new MemoryStream(); // buffered so the upload has a known length
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            // shortcut: old files are not deleted when replaced, clean the bucket occasionally in Supabase > Storage
            var url = await Api.Upload($"{Folder}/{Guid.NewGuid():N}.{ext}", ms, f.ContentType);
            await ValueChanged.InvokeAsync(url);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or IOException) { error = "Upload failed: " + ex.Message; }
        finally { busy = false; }
    }
}
