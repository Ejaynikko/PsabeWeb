<section class="page-banner">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Tag)) { <span class="section-tag light-tag">@Tag</span> }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle)) { <p>@Subtitle</p> }
    </div>
</section>

@code {
    [Parameter] public string? Tag { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
}
