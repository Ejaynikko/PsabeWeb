<section class="section-padding">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="about-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1000"
                         alt="Agricultural landscape" class="about-image" />
                    <div class="about-image-badge">
                        <i class="bi bi-leaf"></i>
                        <div>
                            <strong>Engineering</strong>
                            <span>For a Sustainable Future</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <span class="section-tag">WHO WE ARE</span>
                <h2 class="section-title">Advancing Agricultural and Biosystems Engineering</h2>
                <p class="section-description">
                    The Philippine Society of Agricultural and Biosystems Engineers (PSABE) is a professional
                    organization dedicated to advancing agricultural and biosystems engineering in the Philippines.
                </p>
                <p class="text-muted">
                    Through professional development, technical collaboration, research, and innovation, the
                    organization promotes engineering solutions that contribute to sustainable agriculture and
                    national development.
                </p>

                <div class="about-values">
                    <div><i class="bi bi-check-circle-fill"></i>Professional Excellence</div>
                    <div><i class="bi bi-check-circle-fill"></i>Innovation and Technology</div>
                    <div><i class="bi bi-check-circle-fill"></i>Sustainable Development</div>
                </div>

                @if (ShowButton)
                {
                    <a href="/about" class="btn btn-green mt-4">Learn More <i class="bi bi-arrow-right ms-2"></i></a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    /// <summary>The home page shows a "Learn More" button; the About page itself does not.</summary>
    [Parameter] public bool ShowButton { get; set; }
}
